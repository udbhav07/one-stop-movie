# Copy this file to .env and paste your own values in.
# Vite reads them at build time and the code picks them up via import.meta.env.
# On Cloudflare Pages, set the same names as environment variables instead.

# Firebase console > Project settings > Your apps > Web app > SDK setup
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_DATABASE_URL=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=

# https://www.themoviedb.org/settings/api
TMDB_API_KEY=
