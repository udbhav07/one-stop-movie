# Copy this file to .env and paste your own values in.
# Then run:  node scripts/generate-env.js
# That writes public/js/env.js, which the site needs at runtime.
#
# NOTE: none of these are secrets. Firebase web config and the TMDB key are
# both shipped to the browser and readable in DevTools on any static site.
# They live here to keep the repo clean and make swapping projects a one-liner,
# NOT to hide them. Your actual protection is database.rules.json plus API key
# restrictions in the Google Cloud console.

# Firebase console > Project settings > Your apps > Web app > SDK setup
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_DATABASE_URL=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=

# https://www.themoviedb.org/settings/api
TMDB_API_KEY=
